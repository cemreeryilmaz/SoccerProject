@model List<FixtureListDto>
@{
    Layout = null;
    ViewData["Title"] = "Maç Yönetimi";
    ViewData["ActiveNav"] = "matches";
    ViewData["AdminTitle"] = "Maç Yönetimi";
    ViewData["AdminCrumb"] = "Yönetim / Maçlar";
    var matches = (Model ?? new List<FixtureListDto>()).OrderBy(m => m.FixtureId).ToList();
    int finished = matches.Count(m => m.MatchStatus == MatchStatus.Finished);
    int live = matches.Count(m => m.MatchStatus == MatchStatus.InProgress);
    int notStarted = matches.Count(m => m.MatchStatus == MatchStatus.NotStarted);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] | Serie A Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/admin.css">
</head>
<body class="admin">
    <partial name="_AdminIcons" />
    <partial name="_AdminSidebar" />

    <div class="admin-main">
        <partial name="_AdminTopbar" />

        <main class="admin-content">
            <div class="page-head">
                <div>
                    <span class="page-eyebrow">Serie A 2026/27</span>
                    <h1 class="page-title">Maç Yönetimi</h1>
                    <p class="page-desc">Serie A karşılaşmalarını görüntüleyebilir, ekleyebilir, düzenleyebilir ve silebilirsiniz.</p>
                </div>
                <a class="btn-a btn-a--primary" href="/Match/CreateMatch">
                    <svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg>Yeni Maç Ekle
                </a>
            </div>

            <section class="league-strip" aria-label="Maç özeti">
                <div class="strip-item strip-item--navy"><span class="strip-icon"><svg class="icon" aria-hidden="true"><use href="#i-ball"/></svg></span><div><span class="strip-label">Toplam maç</span><span class="strip-value">@matches.Count</span></div></div>
                <div class="strip-item strip-item--green"><span class="strip-icon"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg></span><div><span class="strip-label">Tamamlanan</span><span class="strip-value">@finished</span></div></div>
                <div class="strip-item strip-item--red"><span class="strip-icon"><svg class="icon" aria-hidden="true"><use href="#i-info"/></svg></span><div><span class="strip-label">Canlı</span><span class="strip-value">@live</span></div></div>
                <div class="strip-item strip-item--blue"><span class="strip-icon"><svg class="icon" aria-hidden="true"><use href="#i-calendar"/></svg></span><div><span class="strip-label">Başlamadı</span><span class="strip-value">@notStarted</span></div></div>
            </section>

            <section class="card-a" aria-label="Maç listesi">
                <div class="table-scroll">
                    <table class="match-table">
                        <caption class="visually-hidden">Serie A maç listesi</caption>
                        <thead>
                            <tr>
                                <th scope="col" class="col-id">ID</th>
                                <th scope="col">Hafta</th>
                                <th scope="col">Tarih</th>
                                <th scope="col">Saat</th>
                                <th scope="col">Ev Sahibi</th>
                                <th scope="col" class="col-score">Skor</th>
                                <th scope="col">Deplasman</th>
                                <th scope="col">Durum</th>
                                <th scope="col" class="col-actions">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!matches.Any())
                            {
                                <tr class="table-empty"><td colspan="9"><strong>Kayıt bulunamadı</strong>Yeni Maç Ekle ile ilk maçı oluşturun.</td></tr>
                            }
                            else
                            {
                                @foreach (var m in matches)
                                {
                                    <partial name="_MatchRow" model="m" />
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="table-foot">
                    <span>Toplam @matches.Count maç</span>
                    <span>Sezon 2026/27</span>
                </div>
            </section>
        </main>
    </div>

    <partial name="_AdminScript" />
</body>
</html>
