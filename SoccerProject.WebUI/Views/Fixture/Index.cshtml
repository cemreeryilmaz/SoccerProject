@using System.Globalization
@model FixtureWeekViewModel
@{
    Layout = null;
    ViewData["Title"] = "Serie A Fikstür";
    var tr = new CultureInfo("tr-TR");

    var ordered = Model.Fixtures.OrderBy(f => f.MatchDate).ToList();
    var groups = ordered.GroupBy(f => f.MatchDate.Date).OrderBy(g => g.Key).ToList();

    var played = ordered.Where(f => f.Status == MatchStatus.Finished || f.Status == MatchStatus.InProgress).ToList();
    var finished = ordered.Where(f => f.Status == MatchStatus.Finished).ToList();
    int goals = played.Sum(f => f.HomeTeamScore + f.AwayTeamScore);
    int draws = finished.Count(f => f.HomeTeamScore == f.AwayTeamScore);
    int homeWins = finished.Count(f => f.HomeTeamScore > f.AwayTeamScore);
    int awayWins = finished.Count(f => f.HomeTeamScore < f.AwayTeamScore);
    int live = ordered.Count(f => f.Status == MatchStatus.InProgress);
    double avg = played.Count > 0 ? (double)goals / played.Count : 0;
    int decided = homeWins + draws + awayWins;

    var featured = finished.FirstOrDefault() ?? ordered.FirstOrDefault();

    string range = "";
    if (ordered.Any())
    {
        var min = ordered.Min(f => f.MatchDate);
        var max = ordered.Max(f => f.MatchDate);
        range = $"{min.ToString("d MMMM", tr)} – {max.ToString("d MMMM yyyy", tr)}";
    }

    int prevWeek = Model.AvailableWeeks.Where(w => w < Model.CurrentWeek).DefaultIfEmpty(Model.CurrentWeek).Max();
    int nextWeek = Model.AvailableWeeks.Where(w => w > Model.CurrentWeek).DefaultIfEmpty(Model.CurrentWeek).Min();

    // Şeritte yalnızca 3 hafta göster (aktif hafta ortada olacak şekilde kaydırılmış pencere)
    var windowWeeks = new List<int>();
    if (Model.AvailableWeeks.Any())
    {
        int idx = Model.AvailableWeeks.IndexOf(Model.CurrentWeek);
        if (idx < 0) idx = 0;
        int start = Math.Max(0, Math.Min(idx - 1, Model.AvailableWeeks.Count - 3));
        windowWeeks = Model.AvailableWeeks.Skip(start).Take(3).ToList();
    }

    string WeekRangeText(int w)
    {
        if (Model.WeekRanges.TryGetValue(w, out var r))
        {
            return $"{r.Start.ToString("d MMM", tr)} – {r.End.ToString("d MMM yyyy", tr)}";
        }
        return "";
    }
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css">
    <style>
        :root {
            --bg: #070F1F; --bg-2: #0B1730; --surface: #0F1D38; --surface-2: #142647;
            --line: #1F3358; --line-soft: rgba(31,51,88,.6); --line-hover: #2C4675;
            --text: #E9F0FB; --text-2: #C4D0E6; --muted: #8B9CC0; --dim: #6A7DA3;
            --blue: #2E7BFF; --blue-bright: #5B9BFF; --blue-soft: rgba(46,123,255,.14);
            --ice: #A9BCDF; --green: #1FC98A; --amber: #F2B53B; --red: #F2475C;
            --radius-lg: 20px; --radius-md: 14px; --radius-sm: 10px;
            --font-display: "Barlow Condensed","Arial Narrow",sans-serif;
            --font-body: "Barlow","Segoe UI",system-ui,sans-serif;
        }
        body.fixtures-page { min-height:100vh; margin:0; background-color:var(--bg);
            background-image: radial-gradient(1100px 480px at 12% -8%, rgba(46,123,255,.20), transparent 62%);
            background-repeat:no-repeat; color:var(--text); font-family:var(--font-body); font-size:16px; line-height:1.5; font-variant-numeric:tabular-nums; }
        .fixtures-shell { padding-block:32px 72px; }
        .visually-hidden { position:absolute!important; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
        a { text-decoration:none; }
        .top-bar { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:18px; }
        .top-bar a { padding:8px 14px; border:1px solid var(--line); border-radius:999px; color:var(--text-2); font-size:.85rem; font-weight:600; }
        .top-bar a:hover { border-color:var(--blue); color:#fff; }
        .team-crest { --size:34px; flex:none; display:inline-grid; place-items:center; width:var(--size); height:var(--size);
            border-radius:50%; background:linear-gradient(180deg,var(--crest-a) 0 70%,var(--crest-b) 70% 100%); color:var(--crest-ink,#fff);
            font-family:var(--font-display); font-size:calc(var(--size)*.34); font-weight:700; line-height:1; padding-bottom:calc(var(--size)*.12);
            box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.16); }
        .team-crest--lg { --size:64px; box-shadow:inset 0 0 0 2px rgba(255,255,255,.18),0 10px 26px rgba(0,0,0,.35); }
        .panel { border:1px solid var(--line); border-radius:var(--radius-lg); background:var(--surface); }
        .panel__head { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:16px 20px; border-bottom:1px solid var(--line); }
        .panel__title { margin:0; font-family:var(--font-display); font-size:1.4rem; font-weight:600; }
        .panel__sub { color:var(--dim); font-size:.8rem; }
        .fixtures-hero { position:relative; overflow:hidden; padding:28px 32px 26px; border:1px solid var(--line); border-radius:var(--radius-lg);
            background:linear-gradient(160deg,#112552 0%,#0B1834 55%,#09142A 100%); }
        .fixtures-hero::before { content:""; position:absolute; inset:0; background:repeating-linear-gradient(90deg,rgba(255,255,255,.022) 0 72px,transparent 72px 144px); pointer-events:none; }
        .fixtures-hero::after { content:""; position:absolute; top:0; left:0; width:100%; height:3px; background:linear-gradient(90deg,var(--blue) 0%,var(--blue-bright) 30%,transparent 75%); }
        .fixtures-hero > * { position:relative; }
        .hero-row { display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:22px; }
        .hero-league { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px; color:var(--muted); font-weight:500; }
        .hero-league__name { display:flex; align-items:center; gap:10px; }
        .league-mark { display:grid; place-items:center; width:30px; height:30px; border-radius:9px; background:linear-gradient(145deg,var(--blue-bright),var(--blue)); color:#fff; font-family:var(--font-display); font-size:.95rem; font-weight:700; box-shadow:0 6px 18px rgba(46,123,255,.35); }
        .hero-title { margin:0; font-family:var(--font-display); font-size:clamp(2.5rem,5.2vw,4rem); font-weight:700; line-height:.95; }
        .hero-subtitle { max-width:52ch; margin:12px 0 0; color:var(--muted); }
        .hero-meta { display:flex; gap:10px; margin:0; }
        .hero-meta > div { min-width:96px; padding:10px 16px; border:1px solid var(--line); border-radius:var(--radius-sm); background:rgba(255,255,255,.035); }
        .hero-meta dt { color:var(--muted); font-size:.8rem; font-weight:500; }
        .hero-meta dd { margin:0; font-family:var(--font-display); font-size:1.65rem; font-weight:600; line-height:1.1; }
        .week-nav { display:flex; align-items:stretch; gap:10px; margin-top:20px; }
        .week-arrow { flex:none; display:grid; place-items:center; width:52px; border:1px solid var(--line); border-radius:var(--radius-md); background:var(--surface); color:var(--text-2); }
        .week-arrow:hover { border-color:var(--line-hover); background:var(--surface-2); }
        .week-arrow.is-disabled { opacity:.35; pointer-events:none; }
        .week-list { flex:1; display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin:0; padding:0; list-style:none; }
        .week-btn { display:block; width:100%; height:100%; padding:12px 16px; border:1px solid var(--line); border-radius:var(--radius-md); background:var(--surface); color:var(--muted); text-align:left; }
        .week-btn:hover { border-color:var(--line-hover); background:var(--surface-2); }
        .week-btn__title { color:var(--text-2); font-family:var(--font-display); font-size:1.4rem; font-weight:600; line-height:1.1; }
        .week-btn.is-active { border-color:var(--blue); background:linear-gradient(160deg,rgba(46,123,255,.24),rgba(46,123,255,.06)); box-shadow:inset 0 -3px 0 var(--blue); }
        .week-btn.is-active .week-btn__title { color:#fff; font-weight:700; }
        .week-btn__head { display:flex; align-items:center; justify-content:space-between; gap:8px; }
        .week-btn__range { display:block; margin-top:5px; color:var(--dim); font-size:.78rem; }
        .week-btn.is-active .week-btn__range { color:var(--ice); }
        .week-badge { flex:none; padding:2px 9px; border-radius:999px; background:var(--blue); color:#fff; font-size:.66rem; font-weight:700; letter-spacing:.02em; white-space:nowrap; }
        .week-jump { display:flex; align-items:center; flex-wrap:wrap; gap:10px 14px; margin:18px 0 12px; }
        .week-jump label { color:var(--muted); font-size:.85rem; font-weight:600; }
        .week-jump select { padding:9px 14px; border:1px solid var(--line); border-radius:var(--radius-md); background:var(--surface); color:var(--text); font:inherit; font-size:.9rem; min-width:230px; cursor:pointer; }
        .week-jump select:hover { border-color:var(--line-hover); }
        .week-jump select:focus { outline:none; border-color:var(--blue); box-shadow:0 0 0 3px var(--blue-soft); }
        .week-jump select option { background:var(--surface); color:var(--text); }
        .week-jump__total { color:var(--dim); font-size:.8rem; }
        .week-info { display:grid; grid-template-columns:auto 1fr; align-items:center; gap:18px 32px; margin-top:16px; padding:18px 22px; }
        .week-info__title { margin:0; font-family:var(--font-display); font-size:2rem; font-weight:700; line-height:1; }
        .week-info__range { margin:4px 0 0; color:var(--muted); font-size:.9rem; }
        .week-facts { display:flex; flex-wrap:wrap; gap:8px; margin:0; padding:0; list-style:none; }
        .week-facts li { padding:6px 12px; border:1px solid var(--line); border-radius:var(--radius-sm); background:var(--bg-2); color:var(--muted); font-size:.85rem; }
        .week-facts strong { margin-right:4px; color:var(--text); font-family:var(--font-display); font-size:1.15rem; font-weight:700; }
        .fixtures-body { margin-top:20px; }
        .fixtures-list { padding:18px 20px 22px; }
        .day-group + .day-group { margin-top:24px; }
        .day-head { display:flex; align-items:baseline; gap:10px; margin:0 0 10px; padding-bottom:8px; border-bottom:1px solid var(--line-soft); }
        .day-head__date { margin:0; font-family:var(--font-display); font-size:1.25rem; font-weight:600; text-transform:capitalize; }
        .day-head__count { color:var(--dim); font-size:.82rem; }
        .day-list { display:grid; gap:10px; margin:0; padding:0; list-style:none; }
        .fixture-card { position:relative; display:grid; grid-template-columns:88px minmax(0,1fr) 92px minmax(0,1fr) 120px; align-items:center; gap:14px; padding:14px 18px; border:1px solid var(--line); border-radius:var(--radius-md); background:var(--bg-2); }
        .fixture-card:hover { border-color:var(--line-hover); background:var(--surface-2); }
        .fixture-card.is-linked { cursor:pointer; }
        .fx-meta { display:flex; flex-direction:column; align-items:flex-start; gap:6px; }
        .fx-time { font-family:var(--font-display); font-size:1.3rem; font-weight:600; line-height:1; }
        .fx-team { display:flex; align-items:center; gap:12px; min-width:0; }
        .fx-team--home { justify-content:flex-end; text-align:right; }
        .fx-name { overflow:hidden; color:var(--text); font-size:1.02rem; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
        .fx-team.is-winner .fx-name { font-weight:700; color:#fff; }
        .fx-team.is-loser .fx-name { color:var(--muted); font-weight:500; }
        .fx-score { display:flex; align-items:center; justify-content:center; gap:8px; padding:6px 0; border:1px solid var(--line); border-radius:var(--radius-sm); background:var(--surface); font-family:var(--font-display); font-size:1.7rem; font-weight:700; line-height:1; }
        .fx-score__sep { width:8px; height:3px; border-radius:2px; background:var(--dim); }
        .fx-score--empty { color:var(--dim); font-size:1.1rem; font-weight:600; padding:11px 0; }
        .fx-action { justify-self:end; color:var(--dim); font-size:.8rem; text-align:right; }
        .fx-link { display:inline-flex; align-items:center; gap:4px; color:var(--blue-bright); font-size:.85rem; font-weight:600; }
        .fx-link::after { content:""; position:absolute; inset:0; border-radius:inherit; }
        .fixture-card:hover .fx-link { text-decoration:underline; }
        .fixture-card--Live { border-color:rgba(31,201,138,.45); background:linear-gradient(90deg,rgba(31,201,138,.08),var(--bg-2) 45%); }
        .fixture-card--Live .fx-score { border-color:rgba(31,201,138,.5); background:rgba(31,201,138,.12); color:#fff; }
        .status { display:inline-flex; align-items:center; gap:6px; padding:2px 9px; border-radius:999px; font-size:.74rem; font-weight:600; white-space:nowrap; }
        .status--NotStarted { background:rgba(139,156,192,.13); color:var(--muted); }
        .status--Finished { background:rgba(255,255,255,.07); color:var(--text-2); }
        .status--Live { background:rgba(31,201,138,.15); color:#7FE8BF; }
        .status--Live::before { content:""; width:6px; height:6px; border-radius:50%; background:var(--green); }
        .side-stack { display:flex; flex-direction:column; gap:20px; position:sticky; top:20px; }
        .summary-list { margin:0; padding:6px 20px 4px; }
        .summary-list > div { display:flex; align-items:baseline; justify-content:space-between; gap:12px; padding:9px 0; }
        .summary-list > div + div { border-top:1px solid var(--line-soft); }
        .summary-list dt { color:var(--muted); font-size:.9rem; font-weight:500; }
        .summary-list dd { margin:0; font-family:var(--font-display); font-size:1.35rem; font-weight:700; line-height:1; }
        .result-split { padding:8px 20px 18px; }
        .result-split__bar { display:flex; gap:3px; height:10px; margin-top:8px; }
        .result-split__bar span { border-radius:4px; min-width:0; }
        .result-split__bar .r-home { background:var(--blue); }
        .result-split__bar .r-draw { background:var(--dim); }
        .result-split__bar .r-away { background:var(--ice); }
        .result-split__legend { display:flex; justify-content:space-between; gap:8px; margin-top:8px; color:var(--dim); font-size:.75rem; }
        .result-split__legend i { width:8px; height:8px; border-radius:2px; display:inline-block; margin-right:4px; }
        .result-split__title { color:var(--muted); font-size:.85rem; }
        .featured { position:relative; overflow:hidden; }
        .featured__body { position:relative; padding:20px; text-align:center; }
        .featured__teams { display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:10px; }
        .featured__team { display:flex; flex-direction:column; align-items:center; gap:10px; min-width:0; }
        .featured__team span:last-child { font-weight:700; font-size:1.05rem; }
        .featured__score { font-family:var(--font-display); font-size:2.4rem; font-weight:700; line-height:1; }
        .featured__score--vs { color:var(--dim); font-size:1.3rem; }
        .featured__info { display:flex; flex-direction:column; gap:4px; margin:16px 0 0; padding:14px 0 0; border-top:1px solid var(--line-soft); list-style:none; color:var(--text-2); font-size:.88rem; }
        .featured__info span { color:var(--dim); }
        .page-note { margin:22px 0 0; color:var(--dim); font-size:.8rem; text-align:center; }
        @@media (max-width: 991.98px) { .side-stack { position:static; } }
        @@media (max-width: 767.98px) {
            .fixture-card { grid-template-columns:minmax(0,1fr) 68px minmax(0,1fr); grid-template-areas:"meta meta meta" "home score away"; gap:10px 8px; padding:12px; }
            .fx-meta { grid-area:meta; flex-direction:row; align-items:center; justify-content:space-between; }
            .fx-team--home { grid-area:home; flex-direction:column-reverse; align-items:center; text-align:center; gap:6px; }
            .fx-team--away { grid-area:away; flex-direction:column; text-align:center; gap:6px; }
            .fx-score { grid-area:score; }
            .fx-action { display:none; }
            .week-list { grid-template-columns:repeat(3,1fr); }
        }
    </style>
</head>
<body class="fixtures-page">
    <main class="fixtures-shell container-xl">

        <div class="top-bar">
            <a href="/Fixture">Fikstür</a>
            <a href="/Standing">Puan Durumu</a>
            <a href="/Players">Futbolcular</a>
            <a href="/Players/TopScorers">Gol Krallığı</a>
            <a href="/Stadiums">Stadyumlar</a>
            <a href="/Match">Maç Sonuçları</a>
        </div>

        <!-- _FixturesHero -->
        <header class="fixtures-hero">
            <div class="hero-league">
                <span class="hero-league__name"><span class="league-mark" aria-hidden="true">SA</span>İtalya, Serie A</span>
            </div>
            <div class="hero-row">
                <div>
                    <h1 class="hero-title">Serie A Fikstür</h1>
                    <p class="hero-subtitle">Haftayı seç, o haftanın tüm maçlarını gün gün, skor ve durum bilgisiyle gör.</p>
                </div>
                <dl class="hero-meta">
                    <div><dt>Sezon</dt><dd>@Model.Season</dd></div>
                    <div><dt>Hafta</dt><dd>@Model.CurrentWeek</dd></div>
                    <div><dt>Maç</dt><dd>@ordered.Count</dd></div>
                </dl>
            </div>
        </header>

        <!-- _WeekSelector -->
        <div class="week-jump">
            <label for="week-select">Haftaya git</label>
            <select id="week-select" onchange="if(this.value){location.href='/Fixture?week='+this.value;}">
                @foreach (var w in Model.AvailableWeeks)
                {
                    <option value="@w" selected="@(w == Model.CurrentWeek)">@w. Hafta@(Model.WeekRanges.ContainsKey(w) ? "  ·  " + WeekRangeText(w) : "")</option>
                }
            </select>
            <span class="week-jump__total">Toplam @Model.AvailableWeeks.Count hafta</span>
        </div>

        <nav class="week-nav" aria-label="Hafta seçici">
            <a class="week-arrow @(prevWeek == Model.CurrentWeek ? "is-disabled" : "")" href="/Fixture?week=@prevWeek" aria-label="Önceki hafta">‹</a>
            <ul class="week-list">
                @foreach (var w in windowWeeks)
                {
                    <li>
                        <a class="week-btn @(w == Model.CurrentWeek ? "is-active" : "")" href="/Fixture?week=@w">
                            <span class="week-btn__head">
                                <span class="week-btn__title">@w. Hafta</span>
                                @if (w == Model.CurrentWeek)
                                {
                                    <span class="week-badge">Aktif hafta</span>
                                }
                            </span>
                            <span class="week-btn__range">@WeekRangeText(w)</span>
                        </a>
                    </li>
                }
            </ul>
            <a class="week-arrow @(nextWeek == Model.CurrentWeek ? "is-disabled" : "")" href="/Fixture?week=@nextWeek" aria-label="Sonraki hafta">›</a>
        </nav>

        <!-- _WeekInfo -->
        <section class="panel week-info">
            <div>
                <h2 class="week-info__title">@Model.CurrentWeek. Hafta</h2>
                <p class="week-info__range">@range</p>
            </div>
            <ul class="week-facts">
                <li><strong>@ordered.Count</strong>maç</li>
                <li><strong>@finished.Count</strong>tamamlandı</li>
                <li><strong>@goals</strong>gol</li>
                @if (live > 0)
                {
                    <li><strong>@live</strong>canlı</li>
                }
            </ul>
        </section>

        <div class="fixtures-body">
            <div class="row g-4">
                <div class="col-lg-8">
                    <section class="panel">
                        <div class="panel__head">
                            <h2 class="panel__title">Haftanın maçları</h2>
                            <span class="panel__sub">Saatler Türkiye saatine göre</span>
                        </div>
                        <div class="fixtures-list">
                            @if (!ordered.Any())
                            {
                                <p class="page-note">Bu hafta için henüz fikstür yayımlanmadı.</p>
                            }
                            else
                            {
                                @foreach (var g in groups)
                                {
                                    <section class="day-group">
                                        <div class="day-head">
                                            <h3 class="day-head__date">@g.Key.ToString("dddd, d MMMM", tr)</h3>
                                            <span class="day-head__count">@g.Count() maç</span>
                                        </div>
                                        <ul class="day-list">
                                            @foreach (var f in g)
                                            {
                                                <partial name="_FixtureCard" model="f" />
                                            }
                                        </ul>
                                    </section>
                                }
                            }
                        </div>
                    </section>
                </div>

                <aside class="col-lg-4">
                    <div class="side-stack">
                        <!-- _WeeklySummary -->
                        <section class="panel">
                            <div class="panel__head"><h2 class="panel__title">@Model.CurrentWeek. Hafta özeti</h2></div>
                            <dl class="summary-list">
                                <div><dt>Maç</dt><dd>@ordered.Count</dd></div>
                                <div><dt>Tamamlanan</dt><dd>@finished.Count</dd></div>
                                <div><dt>Gol</dt><dd>@goals</dd></div>
                                <div><dt>Maç başına gol</dt><dd>@avg.ToString("0.00", tr)</dd></div>
                                <div><dt>Beraberlik</dt><dd>@draws</dd></div>
                                <div><dt>Ev sahibi galibiyeti</dt><dd>@homeWins</dd></div>
                                <div><dt>Deplasman galibiyeti</dt><dd>@awayWins</dd></div>
                            </dl>
                            <div class="result-split">
                                <span class="result-split__title">Sonuç dağılımı</span>
                                @if (decided > 0)
                                {
                                    <div class="result-split__bar" aria-hidden="true">
                                        <span class="r-home" style="flex:@homeWins"></span>
                                        <span class="r-draw" style="flex:@draws"></span>
                                        <span class="r-away" style="flex:@awayWins"></span>
                                    </div>
                                    <div class="result-split__legend">
                                        <span><i style="background:var(--blue)"></i>Ev @homeWins</span>
                                        <span><i style="background:var(--dim)"></i>Beraberlik @draws</span>
                                        <span><i style="background:var(--ice)"></i>Deplasman @awayWins</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="result-split__legend"><span>Henüz tamamlanan maç yok</span></div>
                                }
                            </div>
                        </section>

                        <!-- _FeaturedMatch -->
                        @if (featured != null)
                        {
                            bool fHasScore = featured.Status == MatchStatus.Finished || featured.Status == MatchStatus.InProgress;
                            <section class="panel featured">
                                <div class="panel__head"><h2 class="panel__title">Haftanın öne çıkan maçı</h2></div>
                                <div class="featured__body">
                                    <div class="featured__teams">
                                        <div class="featured__team">
                                            <span class="team-crest team-crest--lg" style="@TeamVisual.Style(featured.HomeTeamName)" aria-hidden="true">@TeamVisual.Code(featured.HomeTeamName)</span>
                                            <span>@featured.HomeTeamName</span>
                                        </div>
                                        @if (fHasScore)
                                        {
                                            <span class="featured__score">@featured.HomeTeamScore-@featured.AwayTeamScore</span>
                                        }
                                        else
                                        {
                                            <span class="featured__score featured__score--vs">vs</span>
                                        }
                                        <div class="featured__team">
                                            <span class="team-crest team-crest--lg" style="@TeamVisual.Style(featured.AwayTeamName)" aria-hidden="true">@TeamVisual.Code(featured.AwayTeamName)</span>
                                            <span>@featured.AwayTeamName</span>
                                        </div>
                                    </div>
                                    <ul class="featured__info">
                                        <li>@featured.Stadium</li>
                                        <li><span>@featured.MatchDate.ToString("dddd, d MMMM", tr)</span> @featured.MatchDate.ToString("HH:mm")</li>
                                    </ul>
                                    @if (featured.Status == MatchStatus.Finished || featured.Status == MatchStatus.InProgress)
                                    {
                                        <div style="margin-top:12px;"><a class="fx-link" style="position:static" href="/Match/Detail/@featured.FixtureId">Maç detayı ›</a></div>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                </aside>
            </div>
        </div>

        <p class="page-note">Veriler API üzerinden (SoccerProject.WebAPI) canlı olarak çekilmektedir.</p>
    </main>
</body>
</html>
