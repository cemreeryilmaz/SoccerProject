@model List<ResultPlayerDto>
@{
    Layout = null;
    ViewData["Title"] = "Serie A Futbolcuları";
    var groups = Model.GroupBy(p => p.TeamName).OrderBy(g => g.Key).ToList();
    var totalPlayers = Model.Count;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css">
    <style>
        :root {
            --bg:#070F1F; --surface:#0F1D38; --surface-2:#142647; --line:#1F3358;
            --text:#E9F0FB; --text-2:#C4D0E6; --muted:#8B9CC0; --dim:#6A7DA3;
            --blue:#2E7BFF; --blue-bright:#5B9BFF; --green:#1FC98A; --amber:#F2B53B; --red:#F2475C;
            --radius-lg:20px; --radius-md:14px; --radius-sm:10px;
            --font-display:"Barlow Condensed","Arial Narrow",sans-serif;
            --font-body:"Barlow","Segoe UI",system-ui,sans-serif;
        }
        body.players-page { min-height:100vh; margin:0; background-color:var(--bg);
            background-image:radial-gradient(1100px 480px at 12% -8%, rgba(46,123,255,.20), transparent 62%);
            background-repeat:no-repeat; color:var(--text); font-family:var(--font-body); }
        a { text-decoration:none; color:inherit; }
        .shell { padding-block:32px 72px; }
        .top-bar { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:18px; }
        .top-bar a { padding:8px 14px; border:1px solid var(--line); border-radius:999px; color:var(--text-2); font-size:.85rem; font-weight:600; }
        .top-bar a:hover, .top-bar a.is-active { border-color:var(--blue); color:#fff; }
        .hero { position:relative; overflow:hidden; padding:30px 32px; border:1px solid var(--line); border-radius:var(--radius-lg); background:linear-gradient(160deg,#112552 0%,#0B1834 55%,#09142A 100%); margin-bottom:24px; }
        .hero::after { content:""; position:absolute; top:0; left:0; width:100%; height:3px; background:linear-gradient(90deg,var(--blue),var(--blue-bright) 30%,transparent 75%); }
        .hero-league { display:flex; align-items:center; gap:10px; margin-bottom:8px; color:var(--muted); font-weight:500; }
        .league-mark { display:grid; place-items:center; width:30px; height:30px; border-radius:9px; background:linear-gradient(145deg,var(--blue-bright),var(--blue)); color:#fff; font-family:var(--font-display); font-weight:700; }
        .hero h1 { margin:0; font-family:var(--font-display); font-size:clamp(2.4rem,5vw,3.6rem); font-weight:700; line-height:.95; }
        .hero p { max-width:60ch; margin:10px 0 0; color:var(--muted); }
        .team-block { margin-top:26px; }
        .team-head { display:flex; align-items:center; gap:12px; margin-bottom:14px; }
        .team-crest { --size:38px; flex:none; display:inline-grid; place-items:center; width:var(--size); height:var(--size);
            border-radius:50%; background:linear-gradient(180deg,var(--crest-a) 0 70%,var(--crest-b) 70% 100%); color:var(--crest-ink,#fff);
            font-family:var(--font-display); font-size:calc(var(--size)*.32); font-weight:700; box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.16); }
        .team-head h2 { margin:0; font-family:var(--font-display); font-size:1.6rem; font-weight:600; }
        .team-head .count { color:var(--dim); font-size:.85rem; }
        .player-card { display:flex; align-items:center; gap:14px; height:100%; padding:14px 16px; border:1px solid var(--line); border-radius:var(--radius-md); background:var(--surface); transition:border-color .15s ease, transform .15s ease, background .15s ease; }
        .player-card:hover { border-color:var(--blue); transform:translateY(-3px); background:var(--surface-2); }
        .avatar { position:relative; flex:none; width:54px; height:54px; border-radius:50%; overflow:hidden; background:var(--surface-2); box-shadow:inset 0 0 0 1.5px var(--line); }
        .avatar img { width:100%; height:100%; object-fit:cover; display:block; }
        .avatar .shirt { position:absolute; right:-2px; bottom:-2px; display:grid; place-items:center; width:22px; height:22px; border-radius:50%; background:var(--blue); color:#fff; font-family:var(--font-display); font-size:.85rem; font-weight:700; box-shadow:0 0 0 2px var(--surface); }
        .player-card__body { min-width:0; }
        .player-card__name { display:block; color:var(--text); font-weight:600; font-size:1.02rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .player-card__meta { color:var(--muted); font-size:.82rem; }
        .player-card__meta .dot { color:var(--dim); margin:0 6px; }
    </style>
</head>
<body class="players-page">
    <main class="shell container-xl">
        <div class="top-bar">
            <a href="/Fixture">Fikstür</a>
            <a href="/Standing">Puan Durumu</a>
            <a href="/Players" class="is-active">Futbolcular</a>
            <a href="/Players/TopScorers">Gol Krallığı</a>
            <a href="/Stadiums">Stadyumlar</a>
            <a href="/Match">Maç Sonuçları</a>
        </div>

        <header class="hero">
            <div class="hero-league"><span class="league-mark" aria-hidden="true">SA</span>İtalya, Serie A · 2026/27</div>
            <h1>Futbolcular</h1>
            <p>Takımlara göre futbolcu kadroları. Bir oyuncuya tıklayarak profilini, yaşını, uyruğunu ve kariyer geçmişini görebilirsiniz. (@totalPlayers futbolcu)</p>
        </header>

        @foreach (var group in groups)
        {
            <section class="team-block">
                <div class="team-head">
                    <span class="team-crest" style="@TeamVisual.Style(group.Key)" aria-hidden="true">@TeamVisual.Code(group.Key)</span>
                    <h2>@group.Key</h2>
                    <span class="count">@group.Count() futbolcu</span>
                </div>
                <div class="row g-3">
                    @foreach (var p in group.OrderBy(x => x.ShirtNumber))
                    {
                        <div class="col-sm-6 col-lg-4 col-xl-3">
                            <a class="player-card" href="/Players/Detail/@p.PlayerId">
                                <span class="avatar">
                                    @if (!string.IsNullOrWhiteSpace(p.PhotoUrl))
                                    {
                                        <img src="@p.PhotoUrl" alt="@p.FullName" loading="lazy" referrerpolicy="no-referrer" />
                                    }
                                    <span class="shirt">@p.ShirtNumber</span>
                                </span>
                                <span class="player-card__body">
                                    <span class="player-card__name">@p.FullName</span>
                                    <span class="player-card__meta">
                                        @p.Position
                                        @if (p.Age != null)
                                        {
                                            <span class="dot">•</span><span>@(p.Age) yaş</span>
                                        }
                                    </span>
                                </span>
                            </a>
                        </div>
                    }
                </div>
            </section>
        }

        @if (!groups.Any())
        {
            <p style="color:var(--muted)">Henüz futbolcu eklenmemiş.</p>
        }
    </main>
</body>
</html>
