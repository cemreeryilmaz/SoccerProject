@model List<ResultStadiumDto>
@{
    Layout = null;
    ViewData["Title"] = "Serie A Stadyumları";
    var stadiums = Model.OrderByDescending(s => s.Capacity).ToList();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css">
    <style>
        :root {
            --bg:#070F1F; --surface:#0F1D38; --surface-2:#142647; --line:#1F3358;
            --text:#E9F0FB; --text-2:#C4D0E6; --muted:#8B9CC0; --dim:#6A7DA3;
            --blue:#2E7BFF; --blue-bright:#5B9BFF; --green:#1FC98A; --amber:#F2B53B;
            --radius-lg:20px; --radius-md:14px;
            --font-display:"Barlow Condensed","Arial Narrow",sans-serif;
            --font-body:"Barlow","Segoe UI",system-ui,sans-serif;
        }
        body.stadiums-page { min-height:100vh; margin:0; background-color:var(--bg);
            background-image:radial-gradient(1100px 480px at 12% -8%, rgba(46,123,255,.20), transparent 62%);
            background-repeat:no-repeat; color:var(--text); font-family:var(--font-body); }
        a { text-decoration:none; color:inherit; }
        .shell { padding-block:32px 72px; }
        .top-bar { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:18px; }
        .top-bar a { padding:8px 14px; border:1px solid var(--line); border-radius:999px; color:var(--text-2); font-size:.85rem; font-weight:600; }
        .top-bar a:hover, .top-bar a.is-active { border-color:var(--blue); color:#fff; }
        .hero { position:relative; overflow:hidden; padding:30px 32px; border:1px solid var(--line); border-radius:var(--radius-lg); background:linear-gradient(160deg,#112552 0%,#0B1834 55%,#09142A 100%); margin-bottom:24px; }
        .hero::after { content:""; position:absolute; top:0; left:0; width:100%; height:3px; background:linear-gradient(90deg,var(--blue),var(--blue-bright) 30%,transparent 75%); }
        .hero-league { display:flex; align-items:center; gap:10px; margin-bottom:8px; color:var(--muted); font-weight:500; }
        .league-mark { display:grid; place-items:center; width:30px; height:30px; border-radius:9px; background:linear-gradient(145deg,var(--blue-bright),var(--blue)); color:#fff; font-family:var(--font-display); font-weight:700; }
        .hero h1 { margin:0; font-family:var(--font-display); font-size:clamp(2.4rem,5vw,3.6rem); font-weight:700; line-height:.95; }
        .hero p { max-width:60ch; margin:10px 0 0; color:var(--muted); }
        .stadium-card { position:relative; display:flex; flex-direction:column; height:100%; padding:22px 22px 18px; border:1px solid var(--line); border-radius:var(--radius-md); background:var(--surface); transition:border-color .15s ease, transform .15s ease, background .15s ease; overflow:hidden; }
        .stadium-card:hover { border-color:var(--blue); transform:translateY(-3px); background:var(--surface-2); }
        .stadium-icon { display:grid; place-items:center; width:46px; height:46px; border-radius:12px; background:rgba(46,123,255,.15); color:var(--blue-bright); margin-bottom:12px; }
        .stadium-icon svg { width:26px; height:26px; }
        .stadium-card h2 { margin:0; font-family:var(--font-display); font-size:1.5rem; font-weight:600; line-height:1.1; }
        .stadium-city { margin:4px 0 0; color:var(--muted); font-size:.9rem; }
        .stadium-cap { margin-top:16px; padding-top:14px; border-top:1px solid var(--line); display:flex; align-items:baseline; justify-content:space-between; }
        .stadium-cap .num { font-family:var(--font-display); font-size:1.8rem; font-weight:700; color:var(--text); }
        .stadium-cap .lbl { color:var(--dim); font-size:.8rem; }
        .cta { margin-top:12px; color:var(--blue-bright); font-weight:600; font-size:.85rem; }
    </style>
</head>
<body class="stadiums-page">
    <main class="shell container-xl">
        <div class="top-bar">
            <a href="/Fixture">Fikstür</a>
            <a href="/Standing">Puan Durumu</a>
            <a href="/Players">Futbolcular</a>
            <a href="/Players/TopScorers">Gol Krallığı</a>
            <a href="/Stadiums" class="is-active">Stadyumlar</a>
            <a href="/Match">Maç Sonuçları</a>
        </div>

        <header class="hero">
            <div class="hero-league"><span class="league-mark" aria-hidden="true">SA</span>İtalya, Serie A · 2026/27</div>
            <h1>Stadyumlar</h1>
            <p>Serie A kulüplerinin stadyumları. Kapasiteye göre sıralı. Bir stadyuma tıklayarak detaylarını ve orada oynanan maçları görebilirsiniz.</p>
        </header>

        <div class="row g-3">
            @foreach (var s in stadiums)
            {
                <div class="col-sm-6 col-lg-4">
                    <a class="stadium-card" href="/Stadiums/Detail/@s.StadiumId">
                        <span class="stadium-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><ellipse cx="12" cy="9" rx="9" ry="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 9v6c0 1.9 4 3.5 9 3.5s9-1.6 9-3.5V9" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                        </span>
                        <h2>@s.Name</h2>
                        <p class="stadium-city">@s.City</p>
                        <div class="stadium-cap">
                            <span class="num">@s.Capacity.ToString("N0")</span>
                            <span class="lbl">kapasite</span>
                        </div>
                        <span class="cta">Detayları gör →</span>
                    </a>
                </div>
            }
        </div>

        @if (!stadiums.Any())
        {
            <p style="color:var(--muted)">Henüz stadyum eklenmemiş.</p>
        }
    </main>
</body>
</html>
