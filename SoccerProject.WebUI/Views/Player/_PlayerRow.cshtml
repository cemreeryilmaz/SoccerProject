@model ResultPlayerDto
<tr>
    <td class="col-id">@Model.PlayerId</td>
    <td>
        <div class="team-cell">
            <span class="team-crest" style="@TeamVisual.Style(Model.TeamName)" aria-hidden="true">@Model.ShirtNumber</span>
            <div>
                <span class="team-name">@Model.FullName</span>
                <span class="team-code">@Model.Position</span>
            </div>
        </div>
    </td>
    <td>
        <div class="team-cell">
            <span class="team-crest team-crest--xs" style="@TeamVisual.Style(Model.TeamName)" aria-hidden="true">@TeamVisual.Code(Model.TeamName)</span>
            <span class="team-name">@Model.TeamName</span>
        </div>
    </td>
    <td>@Model.ShirtNumber</td>
    <td>@Model.Position</td>
    <td class="col-actions">
        <div class="row-actions">
            <a class="act-btn" href="/Player/Careers/@Model.PlayerId" title="Kariyer" aria-label="Kariyer: @Model.FullName"><svg class="icon" aria-hidden="true"><use href="#i-calendar"/></svg></a>
            <a class="act-btn" href="/Player/UpdatePlayer/@Model.PlayerId" title="Düzenle" aria-label="Düzenle: @Model.FullName"><svg class="icon" aria-hidden="true"><use href="#i-edit"/></svg></a>
            <a class="act-btn act-btn--danger" href="/Player/DeletePlayer/@Model.PlayerId" title="Sil" aria-label="Sil: @Model.FullName" onclick="return confirm('@Model.FullName silinsin mi?');"><svg class="icon" aria-hidden="true"><use href="#i-trash"/></svg></a>
        </div>
    </td>
</tr>
